# ===== page-agent 大模型配置（本地直连 DeepSeek）=====
# 复制为 .env.local 后填真实值（.env.local 已被 gitignore，不会提交）。
# 只要填了 VITE_LLM_API_KEY，就浏览器直连 DeepSeek，无需任何服务端。

VITE_LLM_API_KEY=sk-在这里填你的DeepSeek密钥
VITE_LLM_BASE=https://api.deepseek.com/v1
VITE_LLM_MODEL=deepseek-flash

# 模型名：DeepSeek 用 deepseek-chat（推理模型 deepseek-reasoner）。
# 若换成 Vercel AI Gateway，则 base=https://ai-gateway.vercel.sh/v1，模型形如 deepseek/deepseek-v3.2。

# ⚠ 本地自用专属：key 会被打进前端产物，只能本机跑，切勿把这份 dist 对外发布。
#   要用离线静态页，务必 npm run build 后 npm run preview（http 方式），别用 file:// 直接打开。
